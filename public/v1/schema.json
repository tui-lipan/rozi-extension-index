{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tui-lipan.github.io/rozi-extension-index/v1/schema.json",
  "title": "Rozi extension index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "extensions"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/extension" }
    }
  },
  "$defs": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "source", "commit", "manifest_path", "id", "title", "description",
        "version", "api", "min_rozi", "platforms", "homepage", "screenshots", "stars", "updated_at",
        "commands", "services", "agents", "sidebar_tabs", "navigation_targets",
        "suggested_keybindings"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "source": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+\\.git$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "manifest_path": { "const": "extension.toml" },
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 280 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "api": { "const": 1 },
        "min_rozi": {
          "type": ["string", "null"],
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-(0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "platforms": {
          "type": "array",
          "items": { "enum": ["linux", "macos", "windows", "freebsd", "netbsd"] },
          "uniqueItems": true
        },
        "homepage": {
          "type": ["string", "null"],
          "format": "uri",
          "maxLength": 256,
          "pattern": "^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]+)?([/?#][^\\s]*)?$"
        },
        "screenshots": {
          "description": "Image paths relative to the repository root at `commit`.",
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\\.(png|jpg|jpeg|webp)$"
          }
        },
        "stars": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string", "format": "date-time" },
        "commands": { "type": "integer", "minimum": 0 },
        "services": { "type": "integer", "minimum": 0 },
        "agents": { "type": "integer", "minimum": 0 },
        "sidebar_tabs": { "type": "integer", "minimum": 0 },
        "navigation_targets": { "type": "integer", "minimum": 0 },
        "suggested_keybindings": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
